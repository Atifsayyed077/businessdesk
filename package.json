{
  "name": "store-manager",
  "private": true,
  "version": "0.0.4",
  "description": "BusinessDesk - Inventory & Billing (Thermal POS)",
  "author": "BusinessDesk",
  "main": "electron/dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron electron/dist/main.js\"",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron electron/dist/main.js",
    "exe": "node scripts/build-exe.mjs",
    "exe:legacy": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npm run build:electron && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win nsis --publish never",
    "exe:publish": "node scripts/publish-exe.mjs",
    "exe:clean": "node scripts/clean-release.mjs && rimraf dist electron/dist && rimraf \"%LOCALAPPDATA%\\electron-builder\\Cache\\winCodeSign\"",
    "lint": "oxlint"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.8.9",
    "html2canvas-pro": "^2.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.39.0",
    "pocketbase": "^0.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "sql.js": "^1.14.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-is-dev": "^0.3.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "7zip-bin": "^5.2.0",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "localtunnel": "^2.0.2",
    "oxlint": "^1.79.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "wait-on": "^8.0.5"
  }
}
